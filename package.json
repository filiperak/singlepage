{
  "name": "singlepage-router",
  "version": "1.0.5",
  "description": "Micro client-side router with History API, hashbang, and middleware support. TypeScript rewrite of page.js with full type safety and dual ESM/CJS output.",
  "author": "openchubura",
  "license": "MIT",
  "keywords": [
    "router",
    "client-side",
    "history",
    "pushstate",
    "hashbang"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/filiperak/singlepage"
  },
  "homepage": "https://github.com/filiperak/singlepage#readme",
  "bugs": {
    "url": "https://github.com/filiperak/singlepage/issues"
  },
  "type": "module",
  "source": "src/index.ts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/fix-cjs-ext.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "dev": "tsc -p tsconfig.esm.json --watch",
    "clean": "rm -rf dist",
    "lint": "npx eslint src/",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "path-to-regexp": "^6.3.0"
  },
  "devDependencies": {
    "eslint": "^10.2.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.58.2"
  },
  "engines": {
    "node": ">=16"
  }
}
